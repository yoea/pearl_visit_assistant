# 本地分析服务器配置（只存在于使用者的电脑上，绝不进入前端构建产物）
# 复制本文件为 .env 并填入真实值

# DeepSeek API Key（团队共用账号可在 DeepSeek 开放平台创建）
DEEPSEEK_API_KEY=

# 模型名（服务端决定，前端不感知）：deepseek-chat（V3）或 deepseek-reasoner（R1）
DEEPSEEK_MODEL=deepseek-chat

# 监听端口（页面与分析 API 同端口，同源模式）
PORT=5000

# 前端构建产物目录（页面托管；默认 项目根/dist）
# STATIC_DIR=../dist
