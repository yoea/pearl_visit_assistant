# 分析提供者：mock（默认，含未设置/未知值）| real
VITE_ANALYSIS_PROVIDER=mock

# DeepSeek API Key（VITE_ANALYSIS_PROVIDER=real 时必填）
# 部署形态：办公室局域网（x96max 托管页面），Key 随构建注入页面产物——
# 局域网可信环境决策（用户明确授权）；Key 泄露时到 DeepSeek 开放平台重置即可
VITE_DEEPSEEK_API_KEY=

# 模型名（可选，默认 deepseek-chat）
VITE_DEEPSEEK_MODEL=deepseek-chat

# 请求超时毫秒数（默认 60000）
VITE_ANALYSIS_TIMEOUT_MS=60000
