# 分析提供者：mock（默认，含未设置/未知值）| real
VITE_ANALYSIS_PROVIDER=mock

# DeepSeek API Key（VITE_ANALYSIS_PROVIDER=real 时必填）
# 部署形态：办公室局域网（x96max 托管页面），Key 随构建注入页面产物——
# 局域网可信环境决策（用户明确授权）；Key 泄露时到 DeepSeek 开放平台重置即可
VITE_DEEPSEEK_API_KEY=

# 模型名（可选，默认 deepseek-v4-flash）
VITE_DEEPSEEK_MODEL=deepseek-v4-flash

# 请求超时毫秒数（默认 60000）
VITE_ANALYSIS_TIMEOUT_MS=60000

# 平台名称与功能说明（页面标题 / 副标题；改 env 后重新构建生效）
VITE_APP_TITLE=珍珠生走访审核辅助平台
VITE_APP_SUBTITLE=只需上传珍珠生申请表，即可分析学生资料填写问题并提取重点信息，帮您快速审核、面谈。

# 使用统计上报接口（可选）：填写后每次打开/分析成功/失败会 POST 白名单计数
# （工具名/版本/随机浏览器ID/事件/数字，绝不含学生数据）；留空则完全不发送。
# 接口契约见 docs/usage-report-api.md
VITE_USAGE_REPORT_URL=
